POSTGRES_USER=planejador
POSTGRES_PASSWORD=planejador_dev
POSTGRES_DB=planejador
POSTGRES_PORT=5434
DATABASE_URL=postgresql://planejador:planejador_dev@localhost:5434/planejador?schema=public
APP_TIMEZONE=America/Sao_Paulo
PLANNER_PORT=3000

# Opcional: pasta da Academia. Vazio inicia apenas o Planner.
# Academia incluida neste repositorio. Deixe vazio para iniciar apenas o Planner.
GYM_TRACKER_PATH=apps/gym-tracker
GYM_TRACKER_PORT=8501
# GYM_TRACKER_PYTHON=caminho/para/python.exe (padrao: .venv da Academia)

# Banco descartavel exclusivo para testes (compose.test.yaml).
TEST_DATABASE_URL=postgresql://planner_test:planner_test_local@127.0.0.1:5435/planner_test?schema=public

# Identificação enviada apenas pelo servidor à API pública do Chess.com.
CHESS_COM_USER_AGENT="Planner/0.1 (https://github.com/C-J8/planejador-semanal)"
